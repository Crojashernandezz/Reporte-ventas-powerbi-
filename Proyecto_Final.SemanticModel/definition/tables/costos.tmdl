table costos
	lineageTag: 3e9fa209-47c2-42d2-ab4c-87438fca8507

	measure 'Total Ventas' = SUM(ventas[total_venta])
		lineageTag: c19f706c-58e5-4320-8803-8747597537aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Crecimiento Mes Anterior' = ```
			
			VAR VentasActual = [Total Ventas]
			VAR VentasAnterior = 
			    CALCULATE([Total Ventas], PREVIOUSMONTH(Calendario[Date]))
			RETURN 
			    IF(ISBLANK(VentasAnterior), BLANK(), VentasActual - VentasAnterior)
			```
		lineageTag: e5f224ec-02fb-45d9-b679-a616b4a818aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Utilidad =
			
			VAR Ventas = [Total Ventas]
			VAR Costos = [Total Costos]
			
			RETURN Ventas - Costos
		lineageTag: 8a650c93-d8cc-4d18-b0c0-1289bd3bec71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Costos' = sum(costos[total_costo])
		lineageTag: 66908fda-427b-478b-b602-8a66249b5a25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ciudad Mayor Utilidad' = ```
			
			VAR CiudadMaxUtilidad = 
			    TOPN(
			        1, 
			        SUMMARIZE(
			            Sucursales, 
			            Sucursales[ciudad], 
			            "Utilidad", [Utilidad]
			        ), 
			        [Utilidad], 
			        DESC
			    )
			
			RETURN SELECTCOLUMNS(CiudadMaxUtilidad, "Ciudad", Sucursales[ciudad])
			
			```
		lineageTag: c7bd1dca-8d42-47da-b140-1881ced42345

