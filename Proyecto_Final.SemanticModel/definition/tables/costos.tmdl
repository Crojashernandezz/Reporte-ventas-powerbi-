	partition costos = m
		mode: import
		source =
				let
				    Origen = MySQL.Database("localhost", "ventas_costos", [ReturnSingleDatabase=true, Query="SELECT * FROM costos WHERE fecha_costo >= DATE_SUB(CURDATE(), INTERVAL 12 MONTH);#(lf)"])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

